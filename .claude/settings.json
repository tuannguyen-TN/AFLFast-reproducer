{
  "permissions": {
    "deny": [
      "Bash(git push *)", "Bash(git * push)", "Bash(git * push *)",
      "Bash(git commit *)", "Bash(git * commit)", "Bash(git * commit *)",
      "Bash(git rm *)", "Bash(git * rm)", "Bash(git * rm *)",
      "Bash(git reset *)", "Bash(git * reset)", "Bash(git * reset *)",
      "Bash(git restore *)", "Bash(git * restore)", "Bash(git * restore *)",
      "Bash(git checkout *)", "Bash(git * checkout)", "Bash(git * checkout *)",
      "Bash(git config *)", "Bash(git * config)", "Bash(git * config *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/require_ticket_in_commit.py\"", "onFailure": "block" },
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/gate_ticket_done.py\"", "onFailure": "block" },
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/git_policy.py\"", "onFailure": "block" }
        ]
      }
    ]
  }
}
